<?xml version="1.0"?>
<rdf:RDF xmlns="https://saref.etsi.org/saref4syst/v1.1.2/"
     xml:base="https://saref.etsi.org/saref4syst/v1.1.2/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="https://saref.etsi.org/core/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://saref.etsi.org/saref4syst/v1.1.2/">
        <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4syst/v1.1.2/"/>
        <terms:bibliographicCitation xml:lang="en">ZaydVL. Photovoltaic Irrigation System Ontology (PVIS), version 0.1.0. https://w3id.org/pvis/core</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</terms:created>
        <terms:creator>ZaydVL</terms:creator>
        <terms:description xml:lang="en">Ontology for representing photovoltaic-powered irrigation systems, their components, monitoring, control, energy flows, and water distribution, reusing SAREF Core and SAREF4SYST.</terms:description>
        <terms:description xml:lang="es">Ontología para representar sistemas de riego alimentados por energía fotovoltaica, sus componentes, monitorización, control y flujos de energía y agua, reutilizando SAREF Core y SAREF4SYST.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</terms:modified>
        <terms:publisher>ZaydVL</terms:publisher>
        <terms:source rdf:resource="https://github.com/ZaydVL/pvis-ontology"/>
        <terms:title xml:lang="es">Ontología de sistemas de riego fotovoltaico (PVIS)</terms:title>
        <terms:title xml:lang="en">Photovoltaic Irrigation System Ontology (PVIS)</terms:title>
        <vann:preferredNamespacePrefix>pvis</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/pvis/</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">PVIS core vocabulary; normative scope in the accompanying requirements report.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vocabulario PVIS core; alcance normativo en el informe de requisitos adjunto.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">Módulo PVIS core</rdfs:label>
        <rdfs:label xml:lang="en">PVIS core module</rdfs:label>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <skos:editorialNote>draft</skos:editorialNote>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/pvis/drawsWaterFrom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/pvis/drawsWaterFrom">
        <rdfs:domain rdf:resource="https://w3id.org/pvis/PumpingSubsystem"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Fuente operacional de agua; la conexión hidráulica se modela por separado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Operational water source; the hydraulic connection is modelled separately.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">capta agua de</rdfs:label>
        <rdfs:label xml:lang="en">draws water from</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pvis/hasReferenceSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/pvis/hasReferenceSource">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4syst/Connection"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4syst/ConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Endpoint from which a signed positive flow is defined.</rdfs:comment>
        <rdfs:comment xml:lang="es">Extremo desde el que se define un flujo positivo firmado.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">has reference source</rdfs:label>
        <rdfs:label xml:lang="es">tiene origen de referencia</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pvis/hasReferenceTarget -->


    <owl:ObjectProperty rdf:about="https://w3id.org/pvis/hasReferenceTarget">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4syst/Connection"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4syst/ConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Endpoint towards which a signed positive flow is defined.</rdfs:comment>
        <rdfs:comment xml:lang="es">Extremo hacia el que se define un flujo positivo firmado.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">has reference target</rdfs:label>
        <rdfs:label xml:lang="es">tiene destino de referencia</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pvis/irrigatesParcel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/pvis/irrigatesParcel">
        <rdfs:domain rdf:resource="https://w3id.org/pvis/IrrigationSector"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Geographical parcel irrigated by a sector.</rdfs:comment>
        <rdfs:comment xml:lang="es">Parcela geográfica regada por un sector.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">irrigates parcel</rdfs:label>
        <rdfs:label xml:lang="es">riega parcela</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pvis/servesIrrigationEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/pvis/servesIrrigationEntity">
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Receptor servido por un subsistema de distribución, red o sector.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recipient served by a distribution subsystem, network or sector.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">serves irrigation entity</rdfs:label>
        <rdfs:label xml:lang="es">sirve a entidad de riego</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/pvis/ACConnectionPoint -->


    <owl:Class rdf:about="https://w3id.org/pvis/ACConnectionPoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pvis/ElectricalConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Electrical interface for alternating current.</rdfs:comment>
        <rdfs:comment xml:lang="es">Interfaz eléctrica de corriente alterna.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Alternating current connection point</rdfs:label>
        <rdfs:label xml:lang="es">Punto de conexión de corriente alterna</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/DCConnectionPoint -->


    <owl:Class rdf:about="https://w3id.org/pvis/DCConnectionPoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pvis/ElectricalConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Electrical interface for direct current.</rdfs:comment>
        <rdfs:comment xml:lang="es">Interfaz eléctrica de corriente continua.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Direct current connection point</rdfs:label>
        <rdfs:label xml:lang="es">Punto de conexión de corriente continua</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/ElectricalConnection -->


    <owl:Class rdf:about="https://w3id.org/pvis/ElectricalConnection">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/Connection"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Conexión eléctrica entre sistemas, observable como entidad de interés.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electrical connection between systems, observable as a feature of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">Conexión eléctrica</rdfs:label>
        <rdfs:label xml:lang="en">Electrical connection</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/ElectricalConnectionPoint -->


    <owl:Class rdf:about="https://w3id.org/pvis/ElectricalConnectionPoint">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/ConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Interface of one system for a electrical connection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Interfaz de un único sistema para una conexión eléctrica.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Electrical connection point</rdfs:label>
        <rdfs:label xml:lang="es">Punto de conexión eléctrico</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/ElectricalGrid -->


    <owl:Class rdf:about="https://w3id.org/pvis/ElectricalGrid">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">External electrical system that may exchange electricity with a PVIS.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema eléctrico externo que puede intercambiar electricidad con un PVIS.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Electrical grid</rdfs:label>
        <rdfs:label xml:lang="es">Red eléctrica</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/ElectricalSensor -->


    <owl:Class rdf:about="https://w3id.org/pvis/ElectricalSensor">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Sensor"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Physical sensor designed to measure electrical quantities.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sensor físico diseñado para medir magnitudes eléctricas.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Electrical sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor eléctrico</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/FlowSensor -->


    <owl:Class rdf:about="https://w3id.org/pvis/FlowSensor">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Sensor"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Physical sensor designed to measure water flow.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sensor físico diseñado para medir caudal de agua.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Flow sensor</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de caudal</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/HydraulicConnection -->


    <owl:Class rdf:about="https://w3id.org/pvis/HydraulicConnection">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/Connection"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Conexión hidráulica entre sistemas, observable como entidad de interés.</rdfs:comment>
        <rdfs:comment xml:lang="en">Hydraulic connection between systems, observable as a feature of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">Conexión hidráulica</rdfs:label>
        <rdfs:label xml:lang="en">Hydraulic connection</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/HydraulicConnectionPoint -->


    <owl:Class rdf:about="https://w3id.org/pvis/HydraulicConnectionPoint">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/ConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Interface of one system for a hydraulic connection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Interfaz de un único sistema para una conexión hidráulica.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Hydraulic connection point</rdfs:label>
        <rdfs:label xml:lang="es">Punto de conexión hidráulico</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/IrrigationDistributionSubsystem -->


    <owl:Class rdf:about="https://w3id.org/pvis/IrrigationDistributionSubsystem">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Agrupación funcional que distribuye agua a receptores de riego.</rdfs:comment>
        <rdfs:comment xml:lang="en">Functional grouping that distributes water to irrigation recipients.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Irrigation distribution subsystem</rdfs:label>
        <rdfs:label xml:lang="es">Subsistema de distribución de riego</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/IrrigationSector -->


    <owl:Class rdf:about="https://w3id.org/pvis/IrrigationSector">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Agrupación hidráulica o controlable de riego.</rdfs:comment>
        <rdfs:comment xml:lang="en">Hydraulic or controllable irrigation system grouping.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Irrigation sector</rdfs:label>
        <rdfs:label xml:lang="es">Sector de riego</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/IrrigationWaterDistributionNetwork -->


    <owl:Class rdf:about="https://w3id.org/pvis/IrrigationWaterDistributionNetwork">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Infraestructura que distribuye agua de riego.</rdfs:comment>
        <rdfs:comment xml:lang="en">Water infrastructure distributing irrigation water.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Irrigation water distribution network</rdfs:label>
        <rdfs:label xml:lang="es">Red de distribución de agua de riego</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/MechanicalConnection -->


    <owl:Class rdf:about="https://w3id.org/pvis/MechanicalConnection">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/Connection"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="es">Conexión mecánica entre sistemas, observable como entidad de interés.</rdfs:comment>
        <rdfs:comment xml:lang="en">Mechanical connection between systems, observable as a feature of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">Conexión mecánica</rdfs:label>
        <rdfs:label xml:lang="en">Mechanical connection</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/MechanicalConnectionPoint -->


    <owl:Class rdf:about="https://w3id.org/pvis/MechanicalConnectionPoint">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/ConnectionPoint"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Interface of one system for a mechanical connection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Interfaz de un único sistema para una conexión mecánica.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="en">Mechanical connection point</rdfs:label>
        <rdfs:label xml:lang="es">Punto de conexión mecánico</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/PVGenerator -->


    <owl:Class rdf:about="https://w3id.org/pvis/PVGenerator">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Functional system grouping photovoltaic strings.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema funcional que agrupa strings fotovoltaicos.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <rdfs:label xml:lang="es">Generador fotovoltaico</rdfs:label>
        <rdfs:label xml:lang="en">Photovoltaic generator</rdfs:label>
        <skos:editorialNote>stable</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pvis/PVISSite -->


    <owl:Class rdf:about="https://w3id.org/pvis/PVISSite">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
        <terms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</terms:source>
        <rdfs:comment xml:lang="en">Geographical location of a PVIS and feature for local environmental observations.</rdfs:comment>
        <rdfs:comment xml:lang="es">Localización geográfica de un PVIS y entidad de observación ambiental local.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
