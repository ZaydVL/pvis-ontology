@prefix : <https://saref.etsi.org/saref4syst/v1.1.2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://saref.etsi.org/saref4syst/v1.1.2/> .

<https://saref.etsi.org/saref4syst/v1.1.2/> rdf:type owl:Ontology ;
                                             owl:imports <https://saref.etsi.org/core/v4.1.1/> ,
                                                         <https://saref.etsi.org/saref4syst/v1.1.2/> ;
                                             <http://purl.org/dc/terms/bibliographicCitation> "ZaydVL. Photovoltaic Irrigation System Ontology (PVIS), version 0.1.0. https://w3id.org/pvis/core"@en ;
                                             <http://purl.org/dc/terms/created> "2026-11-10"^^xsd:date ;
                                             <http://purl.org/dc/terms/creator> "ZaydVL" ;
                                             <http://purl.org/dc/terms/description> "Ontology for representing photovoltaic-powered irrigation systems, their components, monitoring, control, energy flows, and water distribution, reusing SAREF Core and SAREF4SYST."@en ,
                                                                                    "Ontología para representar sistemas de riego alimentados por energía fotovoltaica, sus componentes, monitorización, control y flujos de energía y agua, reutilizando SAREF Core y SAREF4SYST."@es ;
                                             <http://purl.org/dc/terms/issued> "2026-11-10"^^xsd:date ;
                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                             <http://purl.org/dc/terms/modified> "2026-11-10"^^xsd:date ;
                                             <http://purl.org/dc/terms/publisher> "ZaydVL" ;
                                             <http://purl.org/dc/terms/source> <https://github.com/ZaydVL/pvis-ontology> ;
                                             <http://purl.org/dc/terms/title> "Ontología de sistemas de riego fotovoltaico (PVIS)"@es ,
                                                                              "Photovoltaic Irrigation System Ontology (PVIS)"@en ;
                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "pvis" ;
                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/pvis/" ;
                                             rdfs:comment "PVIS core vocabulary; normative scope in the accompanying requirements report."@en ,
                                                          "Vocabulario PVIS core; alcance normativo en el informe de requisitos adjunto."@es ;
                                             rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                             rdfs:label "Módulo PVIS core"@es ,
                                                        "PVIS core module"@en ;
                                             owl:versionInfo "0.1.0" ;
                                             <http://www.w3.org/2004/02/skos/core#editorialNote> "draft" .

