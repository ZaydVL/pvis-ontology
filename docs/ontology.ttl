#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
<http://www.w3.org/2004/02/skos/core#editorialNote> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/pvis/drawsWaterFrom
<https://w3id.org/pvis/drawsWaterFrom> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/pvis/PumpingSubsystem> ;
                                       rdfs:range <https://saref.etsi.org/core/FeatureOfInterest> ;
                                       <http://purl.org/dc/terms/source> "PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md" ;
                                       rdfs:comment "Fuente operacional de agua; la conexión hidráulica se modela por separado."@es ,
                                                    "Operational water source; the hydraulic connection is modelled separately."@en ;
                                       rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                       rdfs:label "capta agua de"@es ,
                                                  "draws water from"@en ;
                                       <http://www.w3.org/2004/02/skos/core#editorialNote> "stable" .


###  https://w3id.org/pvis/hasReferenceSource
<https://w3id.org/pvis/hasReferenceSource> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://saref.etsi.org/saref4syst/Connection> ;
                                           rdfs:range <https://saref.etsi.org/saref4syst/ConnectionPoint> ;
                                           <http://purl.org/dc/terms/source> "PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md" ;
                                           rdfs:comment "Endpoint from which a signed positive flow is defined."@en ,
                                                        "Extremo desde el que se define un flujo positivo firmado."@es ;
                                           rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                           rdfs:label "has reference source"@en ,
                                                      "tiene origen de referencia"@es ;
                                           <http://www.w3.org/2004/02/skos/core#editorialNote> "stable" .


###  https://w3id.org/pvis/hasReferenceTarget
<https://w3id.org/pvis/hasReferenceTarget> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://saref.etsi.org/saref4syst/Connection> ;
                                           rdfs:range <https://saref.etsi.org/saref4syst/ConnectionPoint> ;
                                           <http://purl.org/dc/terms/source> "PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md" ;
                                           rdfs:comment "Endpoint towards which a signed positive flow is defined."@en ,
                                                        "Extremo hacia el que se define un flujo positivo firmado."@es ;
                                           rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                           rdfs:label "has reference target"@en ,
                                                      "tiene destino de referencia"@es ;
                                           <http://www.w3.org/2004/02/skos/core#editorialNote> "stable" .


###  https://w3id.org/pvis/irrigatesParcel
<https://w3id.org/pvis/irrigatesParcel> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/pvis/IrrigationSector> ;
                                        <http://purl.org/dc/terms/source> "PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md" ;
                                        rdfs:comment "Geographical parcel irrigated by a sector."@en ,
                                                     "Parcela geográfica regada por un sector."@es ;
                                        rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                        rdfs:label "irrigates parcel"@en ,
                                                   "riega parcela"@es ;
                                        <http://www.w3.org/2004/02/skos/core#editorialNote> "stable" .


###  https://w3id.org/pvis/servesIrrigationEntity
<https://w3id.org/pvis/servesIrrigationEntity> rdf:type owl:ObjectProperty ;
                                               <http://purl.org/dc/terms/source> "PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md" ;
                                               rdfs:comment "Receptor servido por un subsistema de distribución, red o sector."@es ,
                                                            "Recipient served by a distribution subsystem, network or sector."@en ;
                                               rdfs:isDefinedBy <https://w3id.org/pvis/core> ;
                                               rdfs:label "serves irrigation entity"@en ,
                                                          "sirve a entidad de riego"@es ;
                                               <http://www.w3.org/2004/02/skos/core#editorialNote> "stable" .


