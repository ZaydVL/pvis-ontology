        <rdfs:label xml:lang="en">DC voltage</rdfs:label>
        <rdfs:label xml:lang="es">Tensión DC</rdfs:label>
        <rdfs:comment xml:lang="en">Potential difference at a DC interface.</rdfs:comment>
        <rdfs:comment xml:lang="es">Diferencia de potencial en una interfaz DC.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
      </ns1:Property>
    </ns1:hasProperty>
