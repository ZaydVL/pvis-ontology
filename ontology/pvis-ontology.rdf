<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:ns1="https://saref.etsi.org/core/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <ns1:FeatureKind rdf:about="https://w3id.org/pvis/VFDInputKind">
    <skos:prefLabel xml:lang="en">Drive electrical input</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Entrada eléctrica del variador</skos:prefLabel>
    <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
    <rdfs:comment xml:lang="en">Functional role of a connection point: drive electrical input.</rdfs:comment>
    <rdfs:comment xml:lang="es">Papel funcional de un punto de conexión: entrada eléctrica del variador.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/pvis/core">
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <rdfs:comment xml:lang="en">PVIS core vocabulary; normative scope in the accompanying requirements report.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vocabulario PVIS core; alcance normativo en el informe de requisitos adjunto.</rdfs:comment>
        <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4syst/v1.1.2/"/>
        <rdfs:label xml:lang="en">PVIS core module</rdfs:label>
        <rdfs:label xml:lang="es">Módulo PVIS core</rdfs:label>
        <skos:editorialNote>draft</skos:editorialNote>
        <owl:versionIRI rdf:resource="https://w3id.org/pvis/core/v0.1.0"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <dcterms:title xml:lang="en">Photovoltaic Irrigation System Ontology (PVIS)</dcterms:title>
        <dcterms:title xml:lang="es">Ontología de sistemas de riego fotovoltaico (PVIS)</dcterms:title>
        <dcterms:description xml:lang="en">Ontology for representing photovoltaic-powered irrigation systems, their components, monitoring, control, energy flows, and water distribution, reusing SAREF Core and SAREF4SYST.</dcterms:description>
        <dcterms:description xml:lang="es">Ontología para representar sistemas de riego alimentados por energía fotovoltaica, sus componentes, monitorización, control y flujos de energía y agua, reutilizando SAREF Core y SAREF4SYST.</dcterms:description>
        <dcterms:creator>ZaydVL</dcterms:creator>
        <dcterms:publisher>ZaydVL</dcterms:publisher>
        <vann:preferredNamespacePrefix>pvis</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/pvis/</vann:preferredNamespaceUri>
        <dcterms:bibliographicCitation xml:lang="en">ZaydVL. Photovoltaic Irrigation System Ontology (PVIS), version 0.1.0. https://w3id.org/pvis/core</dcterms:bibliographicCitation>
        <dcterms:source rdf:resource="https://github.com/ZaydVL/pvis-ontology"/>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dcterms:issued>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dcterms:modified>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <skos:editorialNote>stable</skos:editorialNote>
    <rdfs:label xml:lang="es">Entrada eléctrica del variador</rdfs:label>
    <rdfs:label xml:lang="en">Drive electrical input</rdfs:label>
  </ns1:FeatureKind>
