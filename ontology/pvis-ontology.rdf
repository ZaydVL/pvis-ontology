    <rdfs:comment xml:lang="es">Agrupación hidráulica o controlable de riego.</rdfs:comment>
    <rdfs:comment xml:lang="en">Hydraulic or controllable irrigation system grouping.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
    <skos:editorialNote>stable</skos:editorialNote>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
    <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/pvis/PVISOperatingMode">
    <rdf:type rdf:resource="https://saref.etsi.org/core/State"/>
    <skos:editorialNote>stable</skos:editorialNote>
    <rdfs:comment xml:lang="en">Reusable state describing pvis operating mode.</rdfs:comment>
    <rdfs:comment xml:lang="es">Estado reutilizable que describe modo operativo pvis.</rdfs:comment>
    <ns1:hasStateValue>
      <owl:NamedIndividual rdf:about="https://w3id.org/pvis/GridOnly">
        <ns1:isValueOfState rdf:resource="https://w3id.org/pvis/PVISOperatingMode"/>
        <rdfs:label xml:lang="es">Sólo red</rdfs:label>
        <rdfs:label xml:lang="en">Grid only</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
        <rdfs:comment xml:lang="es">El PVIS opera sólo con suministro de red.</rdfs:comment>
        <rdfs:comment xml:lang="en">PVIS operates using only grid supply.</rdfs:comment>
        <skos:prefLabel xml:lang="es">Sólo red</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Grid only</skos:prefLabel>
        <rdf:type rdf:resource="https://saref.etsi.org/core/StateValue"/>
        <skos:editorialNote>stable</skos:editorialNote>
      </owl:NamedIndividual>
    </ns1:hasStateValue>
    <ns1:hasStateValue>
      <ns1:StateValue rdf:about="https://w3id.org/pvis/Autonomous">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <skos:prefLabel xml:lang="es">Autónomo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Autonomous</skos:prefLabel>
        <skos:editorialNote>stable</skos:editorialNote>
        <ns1:isValueOfState rdf:resource="https://w3id.org/pvis/PVISOperatingMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
        <rdfs:label xml:lang="en">Autonomous</rdfs:label>
        <rdfs:label xml:lang="es">Autónomo</rdfs:label>
        <rdfs:comment xml:lang="es">El PVIS opera sin consumir energía de red.</rdfs:comment>
        <rdfs:comment xml:lang="en">PVIS operates without drawing power from the grid.</rdfs:comment>
      </ns1:StateValue>
    </ns1:hasStateValue>
    <ns1:hasStateValue>
      <ns1:StateValue rdf:about="https://w3id.org/pvis/Hybrid">
        <rdfs:comment xml:lang="en">PVIS operates using photovoltaic and grid supply.</rdfs:comment>
        <rdfs:comment xml:lang="es">El PVIS opera con suministro fotovoltaico y de red.</rdfs:comment>
        <ns1:isValueOfState rdf:resource="https://w3id.org/pvis/PVISOperatingMode"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="en">Hybrid</rdfs:label>
        <rdfs:label xml:lang="es">Híbrido</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
        <skos:prefLabel xml:lang="en">Hybrid</skos:prefLabel>
        <skos:prefLabel xml:lang="es">Híbrido</skos:prefLabel>
        <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
        <skos:editorialNote>stable</skos:editorialNote>
      </ns1:StateValue>
    </ns1:hasStateValue>
    <rdfs:label xml:lang="en">PVIS operating mode</rdfs:label>
    <rdfs:label xml:lang="es">Modo operativo PVIS</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/pvis/core"/>
    <dcterms:source>PVIS normative requirements report v0.2 (2026-09-12); docs/specification-v0.2.md</dcterms:source>
    <skos:prefLabel xml:lang="en">PVIS operating mode</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Modo operativo PVIS</skos:prefLabel>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/pvis/PumpingSubsystem">
    <rdfs:comment xml:lang="es">Agrupación funcional que transfiere agua mediante bombas y sus accionamientos.</rdfs:comment>
